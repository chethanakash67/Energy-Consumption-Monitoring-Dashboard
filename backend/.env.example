# ---------------------------------------------------------------------------
# Backend environment variables. Copy to `.env` and adjust for your machine.
# ---------------------------------------------------------------------------

# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/energy_dashboard?schema=public"

# HTTP port for the Express API.
PORT=4000

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Comma-separated list of origins allowed to call the API / open SSE streams.
CORS_ORIGIN="http://localhost:3000"

# Pull real external no-key APIs and convert them into live readings.
REALTIME_INGEST_ENABLED=true
REALTIME_INGEST_POLL_MS=60000

# Bengaluru defaults. Change these for another site.
REALTIME_LATITUDE=12.9716
REALTIME_LONGITUDE=77.5946
REALTIME_TIMEZONE="Asia/Kolkata"

# Estimation model used because there is no physical meter hardware.
REALTIME_BASE_LOAD_KW=8
REALTIME_SOLAR_CAPACITY_KW=5
REALTIME_DEMAND_ALERT_KW=12
REALTIME_CARBON_ALERT_G_PER_KWH=300

# Optional fallback demo simulator. Keep false for real external API mode.
SIMULATOR_ENABLED=false
SIMULATOR_TICK_MS=4000
